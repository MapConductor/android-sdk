---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';

interface Props {
  arcgisMapsKotlin?: string;
  bomVersion?: string;
  otherPluginsComment?: string;
  arcgisSdkComment?: string;
  bomComment?: string;
  modulesComment?: string;
}

const {
  arcgisMapsKotlin = "{ARCGIS_SDK_VERSION}",
  bomVersion = "{BOM_MODULE_VERSION}",
  otherPluginsComment = "... other plugins",
  arcgisSdkComment = "ArcGIS Maps SDK",
  bomComment = "MapConductor BOM for version management (v{BOM_MODULE_VERSION})",
  modulesComment = "MapConductor modules (versions managed by BOM)",
} = Astro.props;

const kotlinCode = `// App/build.gradle.kts
plugins {
    // ${otherPluginsComment}
    id("com.google.android.libraries.mapsplatform.secrets-gradle-plugin")
}

dependencies {
    // ${arcgisSdkComment}
    implementation(platform("com.esri:arcgis-maps-kotlin-toolkit-bom:${arcgisMapsKotlin}"))
    implementation("com.esri:arcgis-maps-kotlin:${arcgisMapsKotlin}")
    implementation("com.esri:arcgis-maps-kotlin-toolkit-geoview-compose")
    implementation("com.esri:arcgis-maps-kotlin-toolkit-authentication")

    // ${bomComment}
    implementation(platform("com.mapconductor:mapconductor-bom:${bomVersion}"))

    // ${modulesComment}
    implementation("com.mapconductor:core")
    implementation("com.mapconductor:for-arcgis")
}`;

const groovyCode = `// App/build.gradle
plugins {
    // ${otherPluginsComment}
    id 'com.google.android.libraries.mapsplatform.secrets-gradle-plugin'
}

dependencies {
    // ${arcgisSdkComment}
    implementation platform("com.esri:arcgis-maps-kotlin-toolkit-bom:${arcgisMapsKotlin}")
    implementation "com.esri:arcgis-maps-kotlin:${arcgisMapsKotlin}"
    implementation "com.esri:arcgis-maps-kotlin-toolkit-geoview-compose"
    implementation "com.esri:arcgis-maps-kotlin-toolkit-authentication"

    // ${bomComment}
    implementation platform("com.mapconductor:mapconductor-bom:${bomVersion}")

    // ${modulesComment}
    implementation "com.mapconductor:core"
    implementation "com.mapconductor:for-arcgis"
}`;
---

<Tabs>
  <TabItem label="Kotlin (build.gradle.kts)">
    <Code code={kotlinCode} lang="kotlin" />
  </TabItem>
  <TabItem label="Groovy (build.gradle)">
    <Code code={groovyCode} lang="groovy" />
  </TabItem>
</Tabs>
