---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';

interface Props {
  version?: string;
  commentRoot?: string;
}

const {
  version = "2.0.1",
  commentRoot = "(root)/build.gradle.kts"
} = Astro.props;

const kotlinCode = `// ${commentRoot}
plugins {
    id("com.google.android.libraries.mapsplatform.secrets-gradle-plugin") version "${version}" apply false
}`;

const groovyCode = `// (root)/build.gradle
plugins {
    id 'com.google.android.libraries.mapsplatform.secrets-gradle-plugin' version '${version}' apply false
}`;
---

<Tabs>
<TabItem label="Kotlin (build.gradle.kts)">
<Code code={kotlinCode} lang="kotlin" />
</TabItem>
<TabItem label="Groovy (build.gradle)">
<Code code={groovyCode} lang="groovy" />
</TabItem>
</Tabs>
