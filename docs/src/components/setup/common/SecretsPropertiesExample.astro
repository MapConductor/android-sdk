---
import { Code } from '@astrojs/starlight/components';

interface Props {
  entries?: Array<{key: string, value: string, comment?: string}>;
}

const {
  entries = [
    {key: "GOOGLE_MAPS_API_KEY", value: "実際のAPIキー"}
  ]
} = Astro.props;

const code = `# secrets.properties
${entries.map(entry => {
  const comment = entry.comment ? `# ${entry.comment}\n` : '';
  return `${comment}${entry.key}=${entry.value}`;
}).join('\n')}`;
---

<Code code={code} lang="properties" />
