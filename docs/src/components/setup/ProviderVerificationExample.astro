---
import { Code } from '@astrojs/starlight/components';

interface Props {
  provider?: string;
  functionName?: string;
  lat?: number;
  long?: number;
  zoom?: number;
  comment?: string;
  imageUrl?: string;
  extraParams?: string;
}

const {
  provider = "GoogleMaps",
  functionName = "TestGoogleMaps",
  lat = 0.0,
  long = 0.0,
  zoom = 3.0,
  comment = "もし地図が表示されれば、セットアップが正しくできています",
  imageUrl = "~/assets/setup/basic-setup-google.png",
  extraParams = ""
} = Astro.props;

const stateFunction = `remember${provider}ViewState`;
const viewComponent = `${provider}View`;

const extraParamsStr = extraParams ? `,\n${extraParams}` : '';

const code = `@Composable
fun ${functionName}() {
    val mapState = ${stateFunction}(
        cameraPosition =
            MapCameraPositionImpl(
                position = GeoPointImpl.fromLatLong(${lat}, ${long}),
                zoom = ${zoom},
            )${extraParamsStr},
    )

    ${viewComponent}(state = mapState) {
        // ${comment}
    }
}`;
---

<Code code={code} lang="kotlin" />
![{functionName}の実行結果]({imageUrl})
