---
import { Code } from '@astrojs/starlight/components';

interface Props {
  commentForMapViewUsage?: string;
}

const {
  commentForMapViewUsage = "Replace MapView with your chosen map provider, such as GoogleMapView, MapboxMapView"
} = Astro.props;

const code = `// ${commentForMapViewUsage}
MapView(
    state = mapViewState
) {
    Circle(
        center = GeoPoint.fromLatLong(37.7749, -122.4194),
        radiusMeters = 1000.0,
        clickable = true,
        extra = "Clickable circle",
        onClick = { circleEvent ->
            val circle = circleEvent.state
            val clickPoint = circleEvent.clicked

            println("Circle clicked:")
            println("  Center: ${'${'}circle.center}")
            println("  Radius: ${'${'}circle.radiusMeters}m")
            println("  Click point: ${'${'}clickPoint}")
            println("  Extra data: ${'${'}circle.extra}")
        }
    )
}`;
---

<Code code={code} lang="kotlin" />
