---
import { Code } from '@astrojs/starlight/components';

interface Props {
  firstLatitude?: number;
  firstLongitude?: number;
  secondLatitude?: number;
  secondLongitude?: number;
  thirdLatitude?: number;
  thirdLongitude?: number;
  fourthLatitude?: number;
  fourthLongitude?: number;
  vertexPrefix?: string;
  polygonClickedLog?: string;
}

const {
  firstLatitude = 37.7749,
  firstLongitude = -122.4194,
  secondLatitude = 37.7849,
  secondLongitude = -122.4094,
  thirdLatitude = 37.7799,
  thirdLongitude = -122.3994,
  fourthLatitude = 37.7649,
  fourthLongitude = -122.4094,
  vertexPrefix = "Vertex ",
  polygonClickedLog = "Polygon clicked at: ${polygonEvent.clicked}",
} = Astro.props;

const code = `@Composable
fun InteractivePolygonExample() {
    var vertices by remember {
        mutableStateOf(
            listOf(
                GeoPointImpl.fromLatLong(${firstLatitude}, ${firstLongitude}),
                GeoPointImpl.fromLatLong(${secondLatitude}, ${secondLongitude}),
                GeoPointImpl.fromLatLong(${thirdLatitude}, ${thirdLongitude}),
                GeoPointImpl.fromLatLong(${fourthLatitude}, ${fourthLongitude})
            )
        )
    }

    val closedVertices = vertices + vertices.first()

    val polygonState = PolygonState(
        points = closedVertices,
        strokeColor = Color.Red,
        strokeWidth = 3.dp,
        fillColor = Color.Red.copy(alpha = 0.2f)
    )

    val vertexMarkers = vertices.mapIndexed { index, point ->
        MarkerState(
            position = point,
            icon = DefaultIcon(
                fillColor = Color.Red,
                strokeColor = Color.White,
                label = "\${index + 1}",
                scale = 0.8f
            ),
            draggable = true,
            extra = "${vertexPrefix}$" + "index"
        )
    }

    MapView(
        state = mapViewState,
        onMarkerDrag = { markerState ->
            val vertexIndex = markerState.extra.toString().substringAfter("${vertexPrefix}").toIntOrNull()
            vertexIndex?.let { index ->
                vertices = vertices.toMutableList().apply {
                    if (index < size) set(index, markerState.position)
                }
            }
        },
        onPolygonClick = { polygonEvent ->
            println("${polygonClickedLog}")
        }
    ) {
        Polygon(polygonState)
        vertexMarkers.forEach { marker ->
            Marker(marker)
        }
    }
}`;
