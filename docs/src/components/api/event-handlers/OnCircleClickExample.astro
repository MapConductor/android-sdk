---
import { Code } from '@astrojs/starlight/components';

interface Props {
  commentForPrint?: string;
}

const {
  commentForPrint = "A circle clicked at:"
} = Astro.props;

const code = `MapView(
    ...
        onCircleClick = { event ->
            println("${commentForPrint} \${event.clicked.latitude}, \${event.clicked.longitude}")

            event.state.fillColor = Color.Red.copy(
                opacity = 0.7f,
            )
        },
) { }`;
---

<Code code={code} lang="kotlin" />
