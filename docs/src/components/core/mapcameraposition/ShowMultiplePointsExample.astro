---
import { Code } from '@astrojs/starlight/components';

interface Props {
  commentForZoomCalculation?: string;
}

const {
  commentForZoomCalculation = "Custom calculation"
} = Astro.props;

const code = `// Calculate bounds containing all points, then set appropriate zoom
val allPoints = listOf(/* your points */)
val bounds = GeoRectBounds()
allPoints.forEach { bounds.extend(it) }

val centerCamera = MapCameraPosition(
    position = bounds.center ?: GeoPoint.fromLatLong(0.0, 0.0),
    zoom = calculateZoomForBounds(bounds),  // ${commentForZoomCalculation}
    bearing = 0.0,
    tilt = 0.0
)`;
---

<Code code={code} lang="kotlin" />

