---
import { Code } from '@astrojs/starlight/components';

interface Props {
  boundsComment?: string;
  nearLeftComment?: string;
  nearRightComment?: string;
  farLeftComment?: string;
  farRightComment?: string;
}

const {
  boundsComment = "Overall bounding rectangle",
  nearLeftComment = "Bottom-left corner (near to camera)",
  nearRightComment = "Bottom-right corner (near to camera)",
  farLeftComment = "Top-left corner (far from camera)",
  farRightComment = "Top-right corner (far from camera)"
} = Astro.props;

const code = `data class VisibleRegion(
    val bounds: GeoRectBounds,        // ${boundsComment}
    val nearLeft: GeoPointInterface?,          // ${nearLeftComment}
    val nearRight: GeoPointInterface?,         // ${nearRightComment}
    val farLeft: GeoPointInterface?,           // ${farLeftComment}
    val farRight: GeoPointInterface?           // ${farRightComment}
)`;
---

<Code code={code} lang="kotlin" />

