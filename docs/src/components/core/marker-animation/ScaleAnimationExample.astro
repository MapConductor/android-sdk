---
import { Code } from '@astrojs/starlight/components';

interface Props {
  latitude?: number;
  longitude?: number;
  initialScale?: number;
  commentForAnimateScale?: string;
  commentForMapViewUsage?: string;
  expandScale?: number;
  collapsedScale?: number;
  animationDuration?: number;
}

const {
  latitude = 37.7749,
  longitude = -122.4194,
  initialScale = 1.0,
  commentForAnimateScale = "Animate scale changes",
  commentForMapViewUsage = "Replace MapView with your chosen map provider, such as GoogleMapView, MapboxMapView",
  expandScale = 1.5,
  collapsedScale = 1.0,
  animationDuration = 300
} = Astro.props;

const code = `@Composable
fun ScaleAnimationExample() {
    var isExpanded by remember { mutableStateOf(false) }
    val markerState = remember {
        MarkerState(
            position = GeoPointImpl.fromLatLong(${latitude}, ${longitude}),
            icon = DefaultIcon(fillColor = Color.Blue, scale = ${initialScale}f)
        )
    }

    // ${commentForAnimateScale}
    LaunchedEffect(isExpanded) {
        val animation = ScaleAnimation(
            fromScale = if (isExpanded) ${collapsedScale}f else ${expandScale}f,
            toScale = if (isExpanded) ${expandScale}f else ${collapsedScale}f,
            duration = ${animationDuration},
            interpolator = BounceInterpolator()
        )
        markerState.setAnimation(animation)
    }

    // ${commentForMapViewUsage}
    MapView(
        state = mapViewState,
        onMarkerClick = {
            isExpanded = !isExpanded
        }
    ) {
        Marker(markerState)
    }
}`;
---

<Code code={code} lang="kotlin" />

