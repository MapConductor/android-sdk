---
import { Code } from '@astrojs/starlight/components';

interface Props {
  defaultDuration?: number;
}

const {
  defaultDuration = 500
} = Astro.props;

const code = `class ScaleAnimation(
    val fromScale: Float,
    val toScale: Float,
    override val duration: Long = ${defaultDuration},
    override val interpolator: TimeInterpolator? = OvershootInterpolator()
) : MarkerAnimation`;
---

<Code code={code} lang="kotlin" />

