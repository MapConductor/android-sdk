---
import { Code } from '@astrojs/starlight/components';

interface Props {
  latitude?: number;
  longitude?: number;
  label?: string;
  commentForTriggerBounce?: string;
  commentForMapViewUsage?: string;
  bounceHeight?: number;
  animationDuration?: number;
}

const {
  latitude = 37.7749,
  longitude = -122.4194,
  label = "Bounce!",
  commentForTriggerBounce = "Trigger bounce animation",
  commentForMapViewUsage = "Replace MapView with your chosen map provider, such as GoogleMapView, MapboxMapView",
  bounceHeight = 30,
  animationDuration = 800
} = Astro.props;

const code = `@Composable
fun BounceAnimationExample() {
    var triggerBounce by remember { mutableStateOf(false) }
    val markerState = remember {
        MarkerState(
            position = GeoPointImpl.fromLatLong(${latitude}, ${longitude}),
            icon = DefaultIcon(fillColor = Color.Green, label = "${label}")
        )
    }

    // ${commentForTriggerBounce}
    LaunchedEffect(triggerBounce) {
        if (triggerBounce) {
            val animation = BounceAnimation(
                bounceHeight = ${bounceHeight}f,
                duration = ${animationDuration}
            )
            markerState.setAnimation(animation)
            triggerBounce = false
        }
    }

    // ${commentForMapViewUsage}
    MapView(
        state = mapViewState,
        onMarkerClick = {
            triggerBounce = true
        }
    ) {
        Marker(markerState)
    }
}`;
---

<Code code={code} lang="kotlin" />

