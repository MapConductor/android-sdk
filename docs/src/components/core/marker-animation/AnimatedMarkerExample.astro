---
import { Code } from '@astrojs/starlight/components';

interface Props {
  latitude?: number;
  longitude?: number;
  commentForAnimateMarker?: string;
  commentForMapViewUsage?: string;
  commentForClickTrigger?: string;
  commentForAnimateStart?: string;
  commentForAnimateEnd?: string;
  animationDuration?: number;
}

const {
  latitude = 37.7749,
  longitude = -122.4194,
  commentForAnimateMarker = "Animate marker to new position",
  commentForMapViewUsage = "Replace MapView with your chosen map provider, such as GoogleMapView, MapboxMapView",
  commentForClickTrigger = "Triggers animation",
  commentForAnimateStart = "Animation started for marker",
  commentForAnimateEnd = "Animation ended for marker",
  animationDuration = 1500
} = Astro.props;

const code = `@Composable
fun AnimatedMarkerExample() {
    var markerPosition by remember {
        mutableStateOf(GeoPointImpl.fromLatLong(${latitude}, ${longitude}))
    }
    val markerState = remember { MarkerState(position = markerPosition) }

    // ${commentForAnimateMarker}
    LaunchedEffect(markerPosition) {
        val animation = PositionAnimation(
            fromPosition = markerState.position,
            toPosition = markerPosition,
            duration = ${animationDuration}
        )
        markerState.setAnimation(animation)
    }

    // ${commentForMapViewUsage}
    MapView(
        state = mapViewState,
        onMapClick = { clickedPosition ->
            markerPosition = clickedPosition // ${commentForClickTrigger}
        },
        onMarkerAnimateStart = { markerState ->
            println("${commentForAnimateStart}: ${'$'}{markerState.id}")
        },
        onMarkerAnimateEnd = { markerState ->
            println("${commentForAnimateEnd}: ${'$'}{markerState.id}")
        }
    ) {
        Marker(markerState)
    }
}`;
---

<Code code={code} lang="kotlin" />

