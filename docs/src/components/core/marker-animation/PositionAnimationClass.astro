---
import { Code } from '@astrojs/starlight/components';

interface Props {
  defaultDuration?: number;
}

const {
  defaultDuration = 1000
} = Astro.props;

const code = `class PositionAnimation(
    val fromPosition: GeoPoint,
    val toPosition: GeoPoint,
    override val duration: Long = ${defaultDuration},
    override val interpolator: TimeInterpolator? = AccelerateDecelerateInterpolator()
) : MarkerAnimation`;
---

<Code code={code} lang="kotlin" />

