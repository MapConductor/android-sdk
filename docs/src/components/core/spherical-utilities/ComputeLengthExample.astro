---
import { Code } from '@astrojs/starlight/components';

interface Props {
  commentForRouteDescription?: string;
}

const {
  commentForRouteDescription = "Calculate the total length of a path consisting of multiple points"
} = Astro.props;

const code = `val routePoints = listOf(
    GeoPointImpl.fromLatLong(37.7749, -122.4194), // San Francisco
    GeoPointImpl.fromLatLong(37.7849, -122.4094), // North Beach
    GeoPointImpl.fromLatLong(37.7949, -122.3994), // Russian Hill
    GeoPointImpl.fromLatLong(37.8049, -122.3894)  // Fisherman's Wharf
)

val totalDistance = Spherical.computeLength(routePoints)
println("Route length: ${'${'}(totalDistance / 1000).toInt()} km") // ${commentForRouteDescription}`;
---

<Code code={code} lang="kotlin" />
