---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import { Code } from '@astrojs/starlight/components';

interface Props {
  targetSdk?: string;
  minSdk?: string;
  javaVersion?: string;
  kotlinVersion?: string;
  composeBomVersion?: string;
}

const {
  targetSdk = "{ANDROID_TARGET_SDK_VERSION}",
  minSdk = "{ANDROID_MIN_SDK_VERSION}",
  javaVersion = "{JAVA_VERSION}",
  kotlinVersion = "{KOTLIN_VERSION}",
  composeBomVersion = "{JETPACK_COMPOSE_BOM_VERSION}"
} = Astro.props;

const kotlinCode = `plugin {
  id("org.jetbrains.kotlin.plugin.compose:${kotlinVersion}")
  id("org.jetbrains.kotlin.android:${kotlinVersion}")
}

android {
    compileSdk = ${targetSdk}

    defaultConfig {
        minSdk = ${minSdk}
        targetSdk = ${targetSdk}
    }

    buildFeatures {
        compose = true
    }

    composeOptions {
        kotlinCompilerExtensionVersion =
            project.property("${kotlinVersion}").toString()
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_${javaVersion}
        targetCompatibility = JavaVersion.VERSION_${javaVersion}
    }

    kotlinOptions {
        jvmTarget = "${javaVersion}"
    }
}`;

const groovyCode = `plugin {
  id("org.jetbrains.kotlin.plugin.compose:${kotlinVersion}")
  id("org.jetbrains.kotlin.android:${kotlinVersion}")
}
  
android {
    compileSdk ${targetSdk}

    defaultConfig {
        minSdk ${minSdk}
        targetSdk ${targetSdk}
    }

    buildFeatures {
        compose true
    }

    composeOptions {
        kotlinCompilerExtensionVersion 
            project.property("{KOTLIN_VERSION}").toString()
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_${javaVersion}
        targetCompatibility JavaVersion.VERSION_${javaVersion}
    }

    kotlinOptions {
        jvmTarget = '${javaVersion}'
    }
}`;
---

<Tabs>
  <TabItem label="build.gradle.kts">
    <Code code={kotlinCode} lang="kotlin" />
  </TabItem>
  <TabItem label="build.gradle">
    <Code code={groovyCode} lang="groovy" />
  </TabItem>
</Tabs>
