---
import { Code } from '@astrojs/starlight/components';

interface Props {
  latitude?: number;
  longitude?: number;
  extraLabel?: string;
}

const {
  latitude = 37.7749,
  longitude = -122.4194,
  extraLabel = "San Francisco marker"
} = Astro.props;

const code = `val markerState = MarkerState(
    position = GeoPoint.fromLatLong(${latitude}, ${longitude}),
    extra = "${extraLabel}"
)

MapView(state = mapViewState) {
    Marker(markerState)
}`;
---

<Code code={code} lang="kotlin" />
