---
import { Code } from '@astrojs/starlight/components';

interface Props {
  startLatitude?: number;
  startLongitude?: number;
  endLatitude?: number;
  endLongitude?: number;
  markerLabel?: string;
  extraLabel?: string;
}

const {
  startLatitude = 37.7749,
  startLongitude = -122.4194,
  endLatitude = 37.7849,
  endLongitude = -122.4094,
  markerLabel = "Moving",
  extraLabel = "Animated marker"
} = Astro.props;

const code = `@Composable
fun AnimatedMarkerExample() {
    val startPosition = GeoPointImpl.fromLatLong(${startLatitude}, ${startLongitude})
    val endPosition = GeoPointImpl.fromLatLong(${endLatitude}, ${endLongitude})

    var markerState by remember {
        mutableStateOf(
            MarkerState(
                position = startPosition,
                icon = DefaultIcon(fillColor = Color.Green, label = "${markerLabel}"),
                extra = "${extraLabel}"
            )
        )
    }

    LaunchedEffect(Unit) {
        while (true) {
            delay(2000)
            markerState = markerState.copy(
                position = if (markerState.position == startPosition) endPosition else startPosition
            )
        }
    }

    MapView(state = mapViewState) {
        Marker(markerState)
    }
}`;
---

<Code code={code} lang="kotlin" />
