---
import { Code } from '@astrojs/starlight/components';

interface Props {
  restrictedZoneExtra?: string;
  parkingZoneExtra?: string;
  safeZoneExtra?: string;
}

const {
  restrictedZoneExtra = "Restricted Zone",
  parkingZoneExtra = "Parking Zone",
  safeZoneExtra = "Safe Zone"
} = Astro.props;

const code = `val zonePolygons = listOf(
    PolygonState(
        points = restrictedZonePoints,
        strokeColor = Color.Red,
        strokeWidth = 3.dp,
        fillColor = Color.Red.copy(alpha = 0.2f),
        extra = "${restrictedZoneExtra}"
    ),
    PolygonState(
        points = parkingZonePoints,
        strokeColor = Color.Blue,
        strokeWidth = 2.dp,
        fillColor = Color.Blue.copy(alpha = 0.2f),
        extra = "${parkingZoneExtra}"
    ),
    PolygonState(
        points = safeZonePoints,
        strokeColor = Color.Green,
        strokeWidth = 2.dp,
        fillColor = Color.Green.copy(alpha = 0.2f),
        extra = "${safeZoneExtra}"
    )
)

MapView(state = mapViewState) {
    zonePolygons.forEach { zone ->
        Polygon(zone)
    }
}`;
---

<Code code={code} lang="kotlin" />
