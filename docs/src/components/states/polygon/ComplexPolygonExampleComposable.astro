---
import { Code } from '@astrojs/starlight/components';

interface Props {
  commentForStarPolygon?: string;
  centerLatitude?: number;
  centerLongitude?: number;
  outerRadiusDegrees?: number;
  innerRadiusDegrees?: number;
  commentForClosingPolygon?: string;
  extraLabel?: string;
}

const {
  commentForStarPolygon = "星型ポリゴン",
  centerLatitude = 37.7749,
  centerLongitude = -122.4194,
  outerRadiusDegrees = 0.01,
  innerRadiusDegrees = 0.005,
  commentForClosingPolygon = "ポリゴンを閉じる",
  extraLabel = "Star shape"
} = Astro.props;

const code = `@Composable
fun ComplexPolygonExample() {
    // ${commentForStarPolygon}
    val starPolygon = remember {
        val center = GeoPoint.fromLatLong(${centerLatitude}, ${centerLongitude})
        val points = mutableListOf<GeoPointInterface>()

        for (i in 0 until 10) {
            val angle = (i * 36.0) * Math.PI / 180.0
            val radiusMeters = if (i % 2 == 0) ${outerRadiusDegrees} else ${innerRadiusDegrees}
            val lat = center.latitude + radiusMeters * cos(angle)
            val lng = center.longitude + radiusMeters * sin(angle)
            points.add(GeoPoint.fromLatLong(lat, lng))
        }
        points.add(points.first()) // ${commentForClosingPolygon}

        PolygonState(
            points = points,
            strokeColor = Color.Magenta,
            fillColor = Color.Magenta.copy(alpha = 0.4f),
            extra = "${extraLabel}"
        )
    }

    MapView(state = mapViewState) {
        Polygon(starPolygon)
    }
}`;
---

<Code code={code} lang="kotlin" />
