---
import { Code } from '@astrojs/starlight/components';

interface Props {
  marker1Label?: string;
  marker1Lat?: number;
  marker1Long?: number;
  marker2Label?: string;
  marker2Lat?: number;
  marker2Long?: number;
}

const {
  marker1Label = "TT",
  marker1Lat = 35.6586,
  marker1Long = 139.7454,
  marker2Label = "ST",
  marker2Lat = 35.7101,
  marker2Long = 139.8107
} = Astro.props;

const code = `val marker1 = GeoPointImpl.fromLatLong(${marker1Lat}, ${marker1Long})
val marker2 = GeoPointImpl.fromLatLong(${marker2Lat}, ${marker2Long})

GoogleMapView(
    modifier = modifier.fillMaxSize(),
    state = mapViewState,
    onMarkerClick = { markerState ->
        // マーカーがクリックされたときの処理
        when (markerState.extra) {
            "marker1" -> {
                markerState.animate(MarkerAnimation.Drop)
            }
            "marker2" -> {
                markerState.animate(MarkerAnimation.Bounce)
            }
        }
    }
) {
    Marker(
        position = marker1,
        icon = DefaultIcon(label = "${marker1Label}"),
        extra = "marker1"
    )
    Marker(
        position = marker2,
        icon = DefaultIcon(label = "${marker2Label}"),
        extra = "marker2"
    )
}`;
---

<Code code={code} lang="kotlin" />
