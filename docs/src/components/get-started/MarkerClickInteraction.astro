---
import { Code } from '@astrojs/starlight/components';

interface Props {
  marker1Label?: string;
  marker1Lat?: number;
  marker1Long?: number;
  marker2Label?: string;
  marker2Lat?: number;
  marker2Long?: number;
  commentMarkerClicked?: string;
}

const {
  marker1Label = "TT",
  marker1Lat = 35.6586,
  marker1Long = 139.7454,
  marker2Label = "ST",
  marker2Lat = 35.7101,
  marker2Long = 139.8107,
  commentMarkerClicked = "マーカーがクリックされたときの処理"
} = Astro.props;

const code = `val marker1 = GeoPoint.fromLatLong(${marker1Lat}, ${marker1Long})
val marker2 = GeoPoint.fromLatLong(${marker2Lat}, ${marker2Long})

GoogleMapView(
    modifier = modifier.fillMaxSize(),
    state = mapViewState
) {
    Marker(
        position = marker1,
        icon = DefaultIcon(label = "${marker1Label}"),
        extra = "marker1",
        onClick = { markerState ->
            // ${commentMarkerClicked}
            markerState.animate(MarkerAnimation.Drop)
        }
    )
    Marker(
        position = marker2,
        icon = DefaultIcon(label = "${marker2Label}"),
        extra = "marker2",
        onClick = { markerState ->
            // ${commentMarkerClicked}
            markerState.animate(MarkerAnimation.Bounce)
        }
    )
}`;
---

<Code code={code} lang="kotlin" />
