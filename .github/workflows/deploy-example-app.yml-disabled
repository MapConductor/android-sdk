name: Deploy Example App

on:
  push:
    branches: [ release ]
  workflow_dispatch:

jobs:
  deploy-example-app:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout source repository
      uses: actions/checkout@v4
      with:
        fetch-depth: 0

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'

    - name: Setup Gradle
      uses: gradle/actions/setup-gradle@v3

    - name: Configure Git
      run: |
        git config --global user.name "github-actions[bot]"
        git config --global user.email "github-actions[bot]@users.noreply.github.com"

    - name: Clone example app repository
      env:
        GPR_TOKEN: ${{ secrets.GPR_TOKEN }}
        GPR_USER: ${{ vars.GPR_USER }}
      run: |
        git clone https://${GPR_USER}:${GPR_TOKEN}@github.com/MapConductor/example-app-android.git example-app-repo

    - name: Copy example-app directory
      run: |
        rm -rf example-app-repo/*
        cp -r example-app/* example-app-repo/
        cp gradle.properties example-app-repo/
        cp gradle/ example-app-repo/ -r
        cp gradlew example-app-repo/
        cp gradlew.bat example-app-repo/
        cp settings.gradle.kts example-app-repo/

    - name: Convert project dependencies to Maven Central
      run: |
        cd example-app-repo

        # Get current version from gradle.properties
        VERSION=$(grep '^versionName=' ../gradle.properties | cut -d'=' -f2)

        # Replace project dependencies with Maven Central dependencies in build.gradle.kts
        sed -i 's|implementation(project(":mapconductor-core"))|implementation(platform("com.mapconductor:mapconductor-bom:'"$VERSION"'"))\n    implementation("com.mapconductor:core")|g' build.gradle.kts
        sed -i 's|implementation(project(":mapconductor-for-googlemaps"))|implementation("com.mapconductor:for-googlemaps")|g' build.gradle.kts
        sed -i 's|implementation(project(":mapconductor-for-mapbox"))|implementation("com.mapconductor:for-mapbox")|g' build.gradle.kts
        sed -i 's|implementation(project(":mapconductor-for-here"))|implementation("com.mapconductor:for-here")|g' build.gradle.kts
        sed -i 's|implementation(project(":mapconductor-for-arcgis"))|implementation("com.mapconductor:for-arcgis")|g' build.gradle.kts
        sed -i 's|implementation(project(":mapconductor-icons"))|implementation("com.mapconductor:icons")|g' build.gradle.kts
        sed -i 's|implementation(project(":mapconductor-marker-strategy"))|implementation("com.mapconductor:marker-strategy")|g' build.gradle.kts
        sed -i 's|implementation(project(":mapconductor-marker-native-strategy"))|implementation("com.mapconductor:marker-native-strategy")|g' build.gradle.kts

    - name: Update settings.gradle.kts for standalone app
      run: |
        cd example-app-repo
        cat > settings.gradle.kts << 'EOF'
        pluginManagement {
            repositories {
                google {
                    content {
                        includeGroupByRegex("com\\.android.*")
                        includeGroupByRegex("com\\.google.*")
                        includeGroupByRegex("androidx.*")
                    }
                }
                mavenCentral()
                gradlePluginPortal()
            }
        }

        dependencyResolutionManagement {
            repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
            repositories {
                google()
                mavenCentral()
                maven {
                    url = uri("https://api.mapbox.com/downloads/v2/releases/maven")
                    authentication {
                        basic(BasicAuthentication::class)
                    }
                    credentials {
                        username = "mapbox"
                        password = providers.gradleProperty("MAPBOX_DOWNLOADS_TOKEN").get()
                    }
                }
            }
        }

        rootProject.name = "MapConductor Example App"
        include(":app")

        project(":app").projectDir = file(".")
        EOF

    - name: Update app build.gradle.kts
      run: |
        cd example-app-repo

        # Update namespace and application id
        sed -i 's|namespace = "com.mapconductor.example"|namespace = "com.mapconductor.example.app"|g' build.gradle.kts
        sed -i 's|applicationId = "com.mapconductor.example"|applicationId = "com.mapconductor.example.app"|g' build.gradle.kts

        # Remove any remaining project references
        sed -i '/include.*mapconductor/d' settings.gradle.kts 2>/dev/null || true

    - name: Create standalone README.md
      run: |
        cd example-app-repo
        cat > README.md << 'EOF'
        # MapConductor Android Example App

        This is a standalone example application demonstrating the usage of MapConductor Android SDK.

        ## Setup

        1. Clone this repository
        2. Add your API keys to `local.properties`:
           ```
           MAPBOX_DOWNLOADS_TOKEN=your_mapbox_token
           GOOGLE_MAPS_API_KEY=your_google_maps_key
           HERE_API_KEY=your_here_api_key
           ARCGIS_API_KEY=your_arcgis_key
           ```
        3. Build and run the app

        ## Dependencies

        This app uses MapConductor SDK from Maven Central:
        - BOM: `com.mapconductor:mapconductor-bom`
        - Core: `com.mapconductor:core`
        - Provider modules: `com.mapconductor:for-*`

        ## Documentation

        Visit [MapConductor Documentation](https://mapconductor.github.io/android-sdk-doc/) for detailed guides.
        EOF

    - name: Test build
      run: |
        cd example-app-repo
        ./gradlew assembleDebug --no-daemon

    - name: Commit and push changes
      env:
        GPR_TOKEN: ${{ secrets.GPR_TOKEN }}
        GPR_USER: ${{ vars.GPR_USER }}
      run: |
        cd example-app-repo
        git add .
        if git diff --staged --quiet; then
          echo "No changes to commit"
        else
          git commit -m "Update example app from android-sdk@${{ github.sha }}

          - Convert project dependencies to Maven Central libraries
          - Update to use BOM for version management
          - Standalone build configuration

          🤖 Generated with [Claude Code](https://claude.ai/code)

          Co-Authored-By: Claude <noreply@anthropic.com>"
          git push origin main
        fi